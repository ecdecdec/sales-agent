AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_API_VERSION=2025-03-01-preview

NOTION_API_KEY=your_notion_key
NOTION_DATABASE_ID=your_notion_database_id

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_MY_CHAT_ID=your_telegram_chat_id

# Telegram Account #1
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=+7XXXXXXXXXX

# Telegram Account #2
TELEGRAM_API_ID_2=your_telegram_api_id_2
TELEGRAM_API_HASH_2=your_telegram_api_hash_2
TELEGRAM_PHONE_2=+7XXXXXXXXXX

# Telegram Account #3
TELEGRAM_API_ID_3=your_telegram_api_id_3
TELEGRAM_API_HASH_3=your_telegram_api_hash_3
TELEGRAM_PHONE_3=+7XXXXXXXXXX

WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_SESSION_PATH_2=./whatsapp-session-2
SINGLE_WHATSAPP=true
DISABLE_WHATSAPP=false
DISABLE_NOTION=true
DAILY_GPT_BUDGET_USD=5.0
NODE_ENV=development
